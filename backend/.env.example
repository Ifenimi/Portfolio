# Copy this file to .env and fill in real values before running the server.
PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# Optional: used only if you wire up real email sending in routes/contact.js
CONTACT_EMAIL_TO=YOUR_EMAIL@example.com
SMTP_HOST=REPLACE_ME
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
